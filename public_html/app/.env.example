# ============================================================
# Конфигурация сайта «Фрозен Рекордс» — ОБРАЗЕЦ.
# Реальные значения хранятся в файле .env рядом с этим образцом
# (в корне проекта, НЕ внутри public_html). В git .env не попадает.
# В этом файле секретов быть не должно — только плейсхолдеры.
# ============================================================

# Базовый адрес сайта (без слэша в конце).
BASE_URL=https://frozenrecords.tw1.ru

# Часовой пояс (Казань = московское время)
TIMEZONE=Europe/Moscow

# ---------- Админка ----------
# bcrypt-хэш пароля админки. Сгенерировать (замените пароль на свой):
#   php -r "echo password_hash('ваш-длинный-пароль', PASSWORD_BCRYPT), PHP_EOL;"
# Пока хэш пуст — вход в админку заблокирован.
ADMIN_PASSWORD_HASH=

# ---------- E-mail уведомления (ОСНОВНОЙ канал) ----------
# Ящик-ОТПРАВИТЕЛЬ на SMTP хостинга. В панели Timeweb: «Почта» →
# создать ящик на своём домене; хост обычно smtp.timeweb.ru, порт 465 (ssl).
SMTP_HOST=smtp.timeweb.ru
SMTP_PORT=465
# ssl (порт 465) | tls (порт 587) | none (без шифрования, не рекомендуется)
SMTP_SECURE=ssl
SMTP_USER=
SMTP_PASS=
# От чьего имени уходят письма (обычно совпадает с SMTP_USER)
MAIL_FROM=

# Куда слать уведомления о новых заявках.
# ВНИМАНИЕ: если ящик на зарубежном сервисе (gmail.com), письма намеренно
# НЕ содержат персональных данных клиента — только номер заявки и время
# слота. Детали менеджер смотрит в админке.
NOTIFY_EMAIL=

# ---------- Telegram: уведомления и бот-напоминатель ----------
# Токен: в Telegram напишите @BotFather → /newbot → скопируйте токен.
# chat_id заполняется САМ, когда вы отправите боту /start (см. ниже).
# Вызовы идут ТОЛЬКО с сервера; сбои сети не ломают бронирование.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Секрет для проверки запросов от Telegram — создаётся автоматически
# скриптом app/scripts/setup_webhook.php. Вручную заполнять не нужно.
TELEGRAM_WEBHOOK_SECRET=

# Сотрудники с доступом к боту — логины Telegram через запятую, без @.
# Только они видят записи и получают уведомления; всем остальным бот
# отвечает ссылкой на страницу записи. Логин виден в настройках Telegram
# («Имя пользователя»); если он не задан, доступ по нему работать не будет.
TELEGRAM_ADMINS=

# За сколько часов до начала сессии присылать напоминание в Telegram
REMINDER_HOURS_BEFORE=2

# ---------- Яндекс SmartCaptcha ----------
# console.yandex.cloud → «Безопасность» → SmartCaptcha → создать капчу.
# Клиентский ключ (sitekey) — публичный, серверный — секретный.
# Пока ключи пусты, проверка капчи отключена (режим локальной разработки).
SMARTCAPTCHA_CLIENT_KEY=
SMARTCAPTCHA_SERVER_KEY=

# ---------- Яндекс.Метрика ----------
# metrika.yandex.ru → «Добавить счётчик» → номер счётчика (цифры).
# Загружается ТОЛЬКО после нажатия «Принять» в cookie-баннере.
METRIKA_ID=

# ---------- Яндекс.Карты (необязательно) ----------
# developer.tech.yandex.ru → «JavaScript API и HTTP Геокодер» → ключ.
# Если пусто — вместо карты показывается блок с адресом и ссылками.
YANDEX_MAPS_API_KEY=

# ---------- Онлайн-запись ----------
# На сколько дней вперёд открыта запись
BOOKING_HORIZON_DAYS=14
# Максимальная длительность почасовой записи (от 1 до 12 часов)
MAX_BOOKING_HOURS=12
# Максимальная непрерывная запись в сутках (одни сутки = 24 часа)
MAX_BOOKING_DAYS=7
# Максимум заявок с одного IP в час
RATE_LIMIT_PER_HOUR=3

# ---------- Хранение персональных данных ----------
# Через сколько месяцев заявки удаляются автоматически (cron).
# Срок должен совпадать с указанным в privacy.html!
RETENTION_MONTHS=12
