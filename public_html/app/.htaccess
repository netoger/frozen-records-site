# ============================================================
# Служебный каталог: конфиг (.env), код (includes/), база данных (data/),
# скрипты обслуживания. Прямой доступ по HTTP запрещён полностью.
#
# Каталог лежит внутри public_html вынужденно: на этом хостинге PHP заперт
# в пределах корня сайта и не может читать файлы выше него (см. CLAUDE.md,
# п. 3 — разрешённый запасной вариант). Файлы отсюда подключаются только
# из PHP-скриптов сайта, наружу не отдаются.
# ============================================================

<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>

Options -Indexes
